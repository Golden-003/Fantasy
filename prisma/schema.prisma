generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// SOFASCORE FANTASY COACH — BASE DE DONNÉES 100% RÉELLE
// Jeu: Sofascore Fantasy Premier League 2026/27
// Ligue privée: « Le fond de la classe » (5 managers)
// ZÉRO donnée inventée : chaque enregistrement porte sa SOURCE.
// ─────────────────────────────────────────────────────────────────
// Sources:
//  - CAPTURE-CLASSEMENT-13SEPT : capture onglet Ligues (21:22)
//  - CAPTURE-EQUIPE-13SEPT     : capture onglet Mon équipe (21:45)
//  - ARTICLE-PICKS-R4          : article officiel Sofascore 11/09/2026
//  - ARTICLE-NOUVEAUTES-2627   : article officiel règles 28/08/2026
// ═══════════════════════════════════════════════════════════════

// Ligue privée réelle
model League {
  id      String    @id @default("lefond")
  name    String // « Le fond de la classe »
  game    String // Sofascore Fantasy Premier League
  season  String // 2026/27
  budget  Float // 100 (M€)
  managers Manager[]
}

// Les 5 gestionnaires réels de la ligue
model Manager {
  id        String  @id @default(cuid())
  slug      String  @unique // vital_gdb, nik_leroy…
  name      String  // nom d'équipe affiché dans l'app Sofascore
  isUser    Boolean @default(false)
  sortOrder Int
  leagueId  String  @default("lefond")
  league    League  @relation(fields: [leagueId], references: [id])
  scores    RoundScore[]
  squads    SquadSlot[]
  transfers Transfer[]
}

// Points réels par journée (ce qui a été vu sur les captures)
model RoundScore {
  id         String  @id @default(cuid())
  managerId  String
  round      Int
  points     Int? // null = journée pas encore enregistrée dans l'app
  totalAfter Int? // cumul officiel affiché après cette journée
  source     String
  manager    Manager @relation(fields: [managerId], references: [id])

  @@unique([managerId, round])
}

// Joueurs réels — base COMPLÈTE de Premier League (658 joueurs, API officielle)
// price/ownership = valeurs Sofascore quand sourcées (24 joueurs), sinon référence FPL
model Player {
  id          String  @id @default(cuid())
  name        String
  club        String
  clubConfirmed Boolean @default(true)
  position    String // G | D | M | A
  price       Float? // prix Sofascore (M€) si sourcé
  ownership   Float? // % détention Sofascore si sourcé
  priceSource String?
  formNote    String?
  // Stats réelles (API officielle, mises à jour à chaque sync)
  status      String  @default("DISPO") // DISPO | DOUTEUX | ABSENT
  news        String? // ex. blessure / suspension
  form        Float?
  totalPoints Int?
  minutes     Int?
  goals       Int?
  assists     Int?
  xg          Float?
  xa          Float?
  epNext      Float? // projection points prochaine journée
  priceRef    Float? // prix de référence (£M)
  ownershipRef Float? // % détention de référence
  source      String  @default("FPL")
  slots       SquadSlot[]
  liveEntries LiveEntry[]
  transfersIn  Transfer[] @relation("transfersIn")
  transfersOut Transfer[] @relation("transfersOut")
}

// Effectif courant — POUR LES 5 managers (éditable manuellement dans l'app)
model SquadSlot {
  id           String  @id @default(cuid())
  playerId     String
  managerId    String  @default("cmu1bnqaq0003lztqvp5plo3k") // défaut = migration slots existants (Vital_GDB)
  role         String // TITULAIRE | BANC
  slotPosition String // G | D | M | A
  captain      Boolean @default(false)
  round        Int     @default(4)
  pointsR4     Int?
  pointsNote   String?
  player       Player  @relation(fields: [playerId], references: [id])
  manager      Manager @relation(fields: [managerId], references: [id])

  @@unique([managerId, playerId])
}

// Transferts saisis manuellement (lui + les 4 rivaux) — remplace les captures
model Transfer {
  id          String  @id @default(cuid())
  managerId   String
  round       Int
  outPlayerId String?
  inPlayerId  String?
  note        String?
  createdAt   String
  manager     Manager @relation(fields: [managerId], references: [id])
  outPlayer   Player? @relation("transfersOut", fields: [outPlayerId], references: [id])
  inPlayer    Player? @relation("transfersIn", fields: [inPlayerId], references: [id])
}

// Calendrier complet de la saison (380 matches, API officielle)
model Fixture {
  id       String @id @default(cuid())
  round    Int
  club     String
  opponent String
  isHome   Boolean
  kickoff  String? // date/heure du match (ISO)
  source   String

  @@unique([round, club])
}

// Journal d'ingestion : traçabilité complète des données réelles
model DataEvent {
  id     String @id @default(cuid())
  at     String // ISO
  kind   String // CAPTURE | ARTICLE | REGLE | SAISON | SAISIE
  title  String
  detail String
}

// ─────────────────────────────────────────────────────────────────
// MISE À JOUR TEMPS RÉEL (canal live)
// L'app Sofascore sur le téléphone de l'utilisateur reste la source
// des notes live ; il les recopie ici en ~30 s après chaque match
// (ou à la mi-temps) → le coach recalcule instantanément :
// score live, bonus capitaine, classement simulé de la ligue.
// ─────────────────────────────────────────────────────────────────

// Saisie live d'un joueur pour une journée donnée
model LiveEntry {
  id        String  @id @default(cuid())
  round     Int
  playerId  String
  points    Int? // null = pas encore saisi pour cette journée
  note      String? // ex: « après le match », « mi-temps »
  updatedAt String // ISO — horodatage de la dernière saisie
  player    Player  @relation(fields: [playerId], references: [id])

  @@unique([round, playerId])
}

// État de la journée live : capitaine choisi + token éventuel
model LiveRound {
  round         Int     @id
  captainPlayerId String? // capitaine pour cette journée
  tripleCaptain Boolean @default(false) // token Triple Captain (×3) activé
  updatedAt     String
}
