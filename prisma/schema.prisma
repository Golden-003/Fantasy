generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Paramètres de connexion aux DONNÉES RÉELLES (API officielle Fantasy Premier League).
// Aucune donnée fictive : tout le contenu vient de https://fantasy.premierleague.com/api
model Settings {
  id        String   @id @default("default")
  teamId    Int? // ID FPL de mon équipe réelle (entry id, visible dans l'URL du site)
  leagueId  Int? // ID de ma ligue privée classique (visible dans l'URL du classement)
  cookie    String? // (optionnel) cookie de session FPL pour l'accès temps réel /my-team
  updatedAt DateTime @updatedAt
}
